{
  "registry": "leads",
  "path": "06-Leads/leads.csv",
  "id_prefix": "LEAD",
  "id_width": 4,
  "description": "People who might become opportunities. Generic shape; map to your CRM in .sales-system/crm-profile/field-map.json and override picklists in picklists.json.",
  "picklists_overridable": [
    "status",
    "lead_source",
    "disqualified_reason",
    "product_interest",
    "rating"
  ],
  "columns": [
    {
      "name": "id",
      "type": "id",
      "required": true,
      "owner": "local"
    },
    {
      "name": "first_name",
      "type": "text",
      "owner": "crm"
    },
    {
      "name": "last_name",
      "type": "text",
      "required": true,
      "owner": "crm"
    },
    {
      "name": "title",
      "type": "text",
      "owner": "crm"
    },
    {
      "name": "company",
      "type": "text",
      "required": true,
      "owner": "crm"
    },
    {
      "name": "website",
      "type": "url",
      "owner": "crm"
    },
    {
      "name": "email",
      "type": "email",
      "owner": "crm",
      "verify": true
    },
    {
      "name": "phone",
      "type": "text",
      "owner": "crm"
    },
    {
      "name": "linkedin",
      "type": "url",
      "owner": "crm"
    },
    {
      "name": "status",
      "type": "enum",
      "required": true,
      "values": [
        "New",
        "Working",
        "Engaged",
        "Nurture",
        "Qualified",
        "Disqualified",
        "Do Not Contact"
      ],
      "note": "Working state the seller controls. Override values per CRM in the profile.",
      "owner": "crm",
      "verify": true
    },
    {
      "name": "funnel_stage",
      "type": "text",
      "note": "Marketing/lifecycle position if a separate system owns one (HubSpot, Marketo). Often read-only — the profile says whether it may be pushed.",
      "owner": "crm",
      "verify": true
    },
    {
      "name": "rating",
      "type": "enum",
      "values": [
        "Hot",
        "Warm",
        "Cold"
      ],
      "owner": "crm"
    },
    {
      "name": "owner",
      "type": "text",
      "owner": "crm",
      "verify": true
    },
    {
      "name": "secondary_owner",
      "type": "text",
      "note": "SDR/BDR or partner rep also working this lead, if the org splits ownership",
      "owner": "crm"
    },
    {
      "name": "lead_source",
      "type": "enum",
      "values": [
        "Inbound",
        "Outbound",
        "Referral",
        "Event",
        "Webinar",
        "Content",
        "Paid",
        "Organic",
        "Partner",
        "List",
        "Other"
      ],
      "owner": "crm"
    },
    {
      "name": "source_detail",
      "type": "text",
      "owner": "crm"
    },
    {
      "name": "product_interest",
      "type": "text",
      "owner": "crm"
    },
    {
      "name": "industry",
      "type": "text",
      "owner": "crm"
    },
    {
      "name": "company_size",
      "type": "number",
      "owner": "crm"
    },
    {
      "name": "campaign_id",
      "type": "text",
      "note": "Links to 05-Demand-Gen/campaigns.csv. Local only.",
      "owner": "local"
    },
    {
      "name": "created_date",
      "type": "date",
      "owner": "crm"
    },
    {
      "name": "last_activity_date",
      "type": "date",
      "owner": "crm"
    },
    {
      "name": "days_since_active",
      "type": "number",
      "note": "Days since last logged activity. CRM-calculated where available, else derived.",
      "owner": "crm"
    },
    {
      "name": "total_activities",
      "type": "number",
      "owner": "crm"
    },
    {
      "name": "in_sequence",
      "type": "bool",
      "note": "In an active automated cadence (Outreach, Apollo, SalesLoft, HubSpot sequences). Suppresses manual follow-up tasks.",
      "owner": "crm"
    },
    {
      "name": "sequence_name",
      "type": "text",
      "owner": "crm"
    },
    {
      "name": "sequence_next_step_date",
      "type": "date",
      "owner": "crm"
    },
    {
      "name": "contactable",
      "type": "bool",
      "required": true,
      "note": "DERIVED GATE. 'no' if any opt-out, do-not-call, bounce, or left-company flag is set. Nothing may be drafted or sent where this is no. Blocking fields are listed per-CRM in crm-profile/contactability.json.",
      "owner": "derived"
    },
    {
      "name": "contact_restrictions",
      "type": "text",
      "note": "Which flags produced contactable=no, semicolon-separated, e.g. 'marketing-opt-out;email-bounced'",
      "owner": "derived"
    },
    {
      "name": "next_step",
      "type": "text",
      "note": "Short, factual. In some CRMs this is a shared field colleagues read — the profile flags that.",
      "owner": "crm"
    },
    {
      "name": "next_step_date",
      "type": "date",
      "owner": "crm"
    },
    {
      "name": "converted_opp_id",
      "type": "text",
      "owner": "local"
    },
    {
      "name": "disqualified_reason",
      "type": "enum",
      "values": [
        "Bad Data",
        "Not Interested",
        "Not a Good Fit",
        "No Budget",
        "Wrong Timing",
        "Competitor",
        "Duplicate",
        "Other"
      ],
      "owner": "crm"
    },
    {
      "name": "notes",
      "type": "text",
      "owner": "local"
    },
    {
      "name": "crm_id",
      "type": "text",
      "owner": "crm"
    },
    {
      "name": "sync_status",
      "type": "enum",
      "values": [
        "local-only",
        "synced",
        "pending-push",
        "conflict"
      ],
      "owner": "local"
    },
    {
      "name": "crm_last_modified",
      "type": "text",
      "owner": "crm",
      "note": "The CRM's own last-modified stamp as at the last sync. Drift detection compares it against the CRM's current value; without it, which side changed a field is a guess."
    },
    {
      "name": "last_synced",
      "type": "date",
      "owner": "crm",
      "note": "When this row was last reconciled against the CRM. A last_updated later than this means the row is ahead of the CRM and owes a push."
    },
    {
      "name": "last_updated",
      "type": "date",
      "owner": "local"
    }
  ],
  "browsable": true,
  "archive": {
    "when_column": "status",
    "when_values": [
      "Disqualified",
      "Junk"
    ],
    "age_column": "last_updated",
    "keep_days": 180
  }
}
