{
  "registry": "customers",
  "path": "02-Context/Customers/customers.csv",
  "id_prefix": "CUST",
  "id_width": 4,
  "description": "Everyone who is already paying you. Feeds renewals, references, and expansion.",
  "columns": [
    {
      "name": "id",
      "type": "id",
      "required": true,
      "owner": "local"
    },
    {
      "name": "account_name",
      "type": "text",
      "required": true,
      "owner": "crm",
      "verify": true
    },
    {
      "name": "website",
      "type": "url",
      "owner": "crm"
    },
    {
      "name": "industry",
      "type": "text",
      "owner": "crm"
    },
    {
      "name": "segment",
      "type": "enum",
      "values": [
        "SMB",
        "Mid-Market",
        "Enterprise",
        "Strategic"
      ],
      "owner": "crm"
    },
    {
      "name": "country",
      "type": "text",
      "owner": "crm"
    },
    {
      "name": "primary_contact",
      "type": "text",
      "owner": "crm"
    },
    {
      "name": "primary_contact_email",
      "type": "email",
      "owner": "crm"
    },
    {
      "name": "csm_or_owner",
      "type": "text",
      "owner": "crm",
      "verify": true
    },
    {
      "name": "first_closed_date",
      "type": "date",
      "owner": "crm"
    },
    {
      "name": "arr",
      "type": "money",
      "owner": "crm",
      "verify": true
    },
    {
      "name": "contract_start",
      "type": "date",
      "owner": "crm"
    },
    {
      "name": "contract_end",
      "type": "date",
      "owner": "crm",
      "verify": true
    },
    {
      "name": "health",
      "type": "enum",
      "values": [
        "Green",
        "Yellow",
        "Red"
      ],
      "owner": "local"
    },
    {
      "name": "reference_ok",
      "type": "bool",
      "note": "Willing to be a reference?",
      "owner": "local"
    },
    {
      "name": "products",
      "type": "text",
      "owner": "crm"
    },
    {
      "name": "notes",
      "type": "text",
      "owner": "local"
    },
    {
      "name": "crm_id",
      "type": "text",
      "note": "Salesforce record id. Leave blank for local-only records.",
      "owner": "crm"
    },
    {
      "name": "sync_status",
      "type": "enum",
      "values": [
        "local-only",
        "synced",
        "pending-push",
        "conflict"
      ],
      "owner": "local"
    },
    {
      "name": "crm_last_modified",
      "type": "text",
      "owner": "crm",
      "note": "The CRM's own last-modified stamp as at the last sync. Drift detection compares it against the CRM's current value; without it, which side changed a field is a guess."
    },
    {
      "name": "last_synced",
      "type": "date",
      "owner": "crm",
      "note": "When this row was last reconciled against the CRM. A last_updated later than this means the row is ahead of the CRM and owes a push."
    },
    {
      "name": "last_updated",
      "type": "date",
      "owner": "local"
    }
  ],
  "browsable": true
}
