{
  "registry": "quote_lines",
  "path": "12-Quotes/quote-lines.csv",
  "id_prefix": "QLINE",
  "id_width": 5,
  "browsable": true,
  "description": "Line items. One row per product on a quote. Prices resolved from the price list, never typed.",
  "picklists_overridable": [
    "discount_reason"
  ],
  "columns": [
    {
      "name": "id",
      "type": "id",
      "required": true,
      "owner": "local"
    },
    {
      "name": "quote_id",
      "type": "text",
      "required": true,
      "owner": "local"
    },
    {
      "name": "line_no",
      "type": "number",
      "owner": "local"
    },
    {
      "name": "sku",
      "type": "text",
      "required": true,
      "owner": "local"
    },
    {
      "name": "name",
      "type": "text",
      "owner": "local"
    },
    {
      "name": "quantity",
      "type": "number",
      "required": true,
      "owner": "local"
    },
    {
      "name": "unit",
      "type": "text",
      "owner": "local"
    },
    {
      "name": "list_unit_price",
      "type": "money",
      "required": true,
      "note": "From the price list, at the tier the quantity earns",
      "owner": "local"
    },
    {
      "name": "tier_applied",
      "type": "number",
      "note": "Which volume tier the quantity reached",
      "owner": "local"
    },
    {
      "name": "discount_pct",
      "type": "number",
      "owner": "local"
    },
    {
      "name": "discount_reason",
      "type": "text",
      "note": "REQUIRED where a discount is applied. A discount with no reason is a discount nobody can defend at renewal.",
      "owner": "local"
    },
    {
      "name": "net_unit_price",
      "type": "money",
      "note": "DERIVED",
      "owner": "derived"
    },
    {
      "name": "extended",
      "type": "money",
      "required": true,
      "note": "DERIVED: quantity x net unit price",
      "owner": "derived"
    },
    {
      "name": "below_floor",
      "type": "bool",
      "note": "DERIVED. Should never be yes on a sent quote.",
      "owner": "derived"
    },
    {
      "name": "notes",
      "type": "text",
      "owner": "local"
    },
    {
      "name": "last_updated",
      "type": "date",
      "owner": "local"
    }
  ],
  "archive": {
    "follow": {
      "registry": "quotes",
      "key": "quote_id"
    }
  }
}
