{
  "registry": "tasks",
  "path": "01-Tasks/tasks.csv",
  "id_prefix": "TASK",
  "id_width": 5,
  "description": "Every action the system or the user is tracking, across all modules. The one file a seller opens daily.",
  "columns": [
    {
      "name": "id",
      "type": "id",
      "required": true,
      "owner": "local"
    },
    {
      "name": "title",
      "type": "text",
      "required": true,
      "note": "Imperative and specific: 'Send pricing follow-up to Jane Doe (Acme)'",
      "owner": "local"
    },
    {
      "name": "status",
      "type": "enum",
      "required": true,
      "values": [
        "Open",
        "Drafted",
        "Awaiting Approval",
        "Scheduled",
        "Done",
        "Cancelled",
        "Blocked",
        "Snoozed"
      ],
      "owner": "local"
    },
    {
      "name": "automation",
      "type": "enum",
      "required": true,
      "values": [
        "auto",
        "review",
        "manual"
      ],
      "note": "auto = system acts; review = system drafts, you approve; manual = you do it",
      "owner": "local"
    },
    {
      "name": "task_type",
      "type": "enum",
      "values": [
        "Email Follow-up",
        "Cold Outreach",
        "Call",
        "Meeting",
        "Meeting Prep",
        "Research",
        "Send Content",
        "Proposal",
        "CRM Update",
        "Internal",
        "Admin",
        "Other"
      ],
      "owner": "local"
    },
    {
      "name": "priority",
      "type": "enum",
      "values": [
        "High",
        "Medium",
        "Low"
      ],
      "owner": "local"
    },
    {
      "name": "due_date",
      "type": "date",
      "owner": "local"
    },
    {
      "name": "owner",
      "type": "text",
      "owner": "local"
    },
    {
      "name": "related_type",
      "type": "enum",
      "values": [
        "lead",
        "opportunity",
        "renewal",
        "customer",
        "campaign",
        "competitor",
        "account",
        "brief",
        "none"
      ],
      "owner": "local"
    },
    {
      "name": "related_id",
      "type": "text",
      "note": "e.g. LEAD-0042, OPP-0031. The link back to the record.",
      "owner": "local"
    },
    {
      "name": "account_name",
      "type": "text",
      "note": "Denormalised on purpose so the spreadsheet reads without lookups",
      "owner": "local"
    },
    {
      "name": "contact_name",
      "type": "text",
      "owner": "local"
    },
    {
      "name": "contact_email",
      "type": "email",
      "owner": "local"
    },
    {
      "name": "created_date",
      "type": "date",
      "owner": "local"
    },
    {
      "name": "created_by",
      "type": "text",
      "note": "'user' or the skill that raised it, e.g. 'daily-brief'",
      "owner": "local"
    },
    {
      "name": "why",
      "type": "text",
      "note": "One line of justification. Tasks with no reason get ignored and erode trust.",
      "owner": "local"
    },
    {
      "name": "draft_path",
      "type": "text",
      "note": "Relative path to the drafted email or asset awaiting approval",
      "owner": "local"
    },
    {
      "name": "verify_by",
      "type": "enum",
      "values": [
        "email-sent",
        "email-reply",
        "calendar-event",
        "crm-activity",
        "crm-field",
        "file-created",
        "manual-only"
      ],
      "note": "How the system can tell this got done, including manually",
      "owner": "local"
    },
    {
      "name": "verify_target",
      "type": "text",
      "note": "What to look for: an email address, a meeting title, a CRM field",
      "owner": "local"
    },
    {
      "name": "completed_date",
      "type": "date",
      "owner": "local"
    },
    {
      "name": "completed_how",
      "type": "enum",
      "values": [
        "user-manual",
        "user-approved",
        "system-auto",
        "detected",
        "not-completed"
      ],
      "owner": "local"
    },
    {
      "name": "completion_evidence",
      "type": "text",
      "note": "Human-readable proof, e.g. 'email to jane@acme.com sent 2026-08-04 09:12'",
      "owner": "local"
    },
    {
      "name": "recurrence",
      "type": "enum",
      "values": [
        "none",
        "daily",
        "weekdays",
        "weekly",
        "biweekly",
        "monthly",
        "quarterly"
      ],
      "owner": "local"
    },
    {
      "name": "snooze_until",
      "type": "date",
      "owner": "local"
    },
    {
      "name": "blocked_reason",
      "type": "text",
      "owner": "local"
    },
    {
      "name": "notes",
      "type": "text",
      "owner": "local"
    },
    {
      "name": "external_system",
      "type": "text",
      "note": "Where else this task lives: todoist, reminders, asana, etc. Blank = this folder only.",
      "owner": "local"
    },
    {
      "name": "external_id",
      "type": "text",
      "note": "That system's id for this task, so a two-way bridge can match without guessing.",
      "owner": "local"
    },
    {
      "name": "last_updated",
      "type": "date",
      "owner": "local"
    }
  ],
  "browsable": true,
  "archive": {
    "when_column": "status",
    "when_values": [
      "Done",
      "Cancelled"
    ],
    "age_column": "completed_date",
    "keep_days": 60
  }
}
