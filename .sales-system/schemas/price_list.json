{
  "registry": "price_list",
  "path": "12-Quotes/price-list.csv",
  "id_prefix": "SKU",
  "id_width": 4,
  "browsable": true,
  "description": "What things cost. The single source of price truth — a quote may never invent a price for something not on this list. Volume tiers are columns rather than rows so the whole product line reads at a glance.",
  "picklists_overridable": [
    "unit",
    "product_family",
    "billing_frequency",
    "status"
  ],
  "columns": [
    {
      "name": "id",
      "type": "id",
      "required": true,
      "owner": "local"
    },
    {
      "name": "sku",
      "type": "text",
      "required": true,
      "note": "The code that appears on the quote",
      "owner": "local"
    },
    {
      "name": "name",
      "type": "text",
      "required": true,
      "owner": "local"
    },
    {
      "name": "description",
      "type": "text",
      "owner": "local"
    },
    {
      "name": "product_family",
      "type": "text",
      "owner": "local"
    },
    {
      "name": "unit",
      "type": "enum",
      "required": true,
      "values": [
        "Device",
        "App",
        "User",
        "Site",
        "Scan",
        "Seat",
        "Instance",
        "Flat",
        "Hour",
        "Day"
      ],
      "note": "What one of these is. Drives the quantity question and how the line reads.",
      "owner": "local"
    },
    {
      "name": "list_price",
      "type": "money",
      "required": true,
      "note": "Price per unit at tier 1. Never quote below this without a recorded discount.",
      "owner": "local"
    },
    {
      "name": "currency",
      "type": "text",
      "owner": "local"
    },
    {
      "name": "term_months",
      "type": "number",
      "note": "Default contract term this price assumes. A 12-month price quoted for 36 months is a different deal.",
      "owner": "local"
    },
    {
      "name": "billing_frequency",
      "type": "enum",
      "values": [
        "Annual",
        "Monthly",
        "Quarterly",
        "One-time",
        "Upfront"
      ],
      "owner": "local"
    },
    {
      "name": "min_quantity",
      "type": "number",
      "owner": "local"
    },
    {
      "name": "increment",
      "type": "text",
      "note": "Must be bought in multiples of this",
      "owner": "local"
    },
    {
      "name": "tier2_min_qty",
      "type": "number",
      "owner": "local"
    },
    {
      "name": "tier2_price",
      "type": "money",
      "owner": "local"
    },
    {
      "name": "tier3_min_qty",
      "type": "number",
      "owner": "local"
    },
    {
      "name": "tier3_price",
      "type": "money",
      "owner": "local"
    },
    {
      "name": "tier4_min_qty",
      "type": "number",
      "owner": "local"
    },
    {
      "name": "tier4_price",
      "type": "money",
      "owner": "local"
    },
    {
      "name": "floor_price",
      "type": "money",
      "note": "Absolute lowest permitted, whatever the discount. The guard rail that stops a quote going out below cost.",
      "owner": "local"
    },
    {
      "name": "max_discount_no_approval",
      "type": "number",
      "note": "Percent. Above this the quote needs sign-off — recorded so the system can say so at quote time rather than after.",
      "owner": "local"
    },
    {
      "name": "status",
      "type": "enum",
      "required": true,
      "values": [
        "Active",
        "Deprecated",
        "Draft"
      ],
      "owner": "local"
    },
    {
      "name": "effective_from",
      "type": "date",
      "owner": "local"
    },
    {
      "name": "effective_to",
      "type": "date",
      "owner": "local"
    },
    {
      "name": "notes",
      "type": "text",
      "owner": "local"
    },
    {
      "name": "last_updated",
      "type": "date",
      "owner": "local"
    }
  ]
}
